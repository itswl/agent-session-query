# The published image. The release workflow builds it from the binaries its build matrix
# already produced — downloaded into dist-image/<os>/<arch>/ — so the container carries
# the same bytes as the released archives and this file never runs a compiler.
#
# To build from source instead (a change of your own, a mirror), use Dockerfile.
FROM alpine:3 AS certs
RUN apk add --no-cache ca-certificates

FROM scratch

ARG TARGETOS TARGETARCH
# --chmod: artifact upload and download do not keep file modes
COPY --chmod=755 dist-image/${TARGETOS}/${TARGETARCH}/asq /asq
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# See Dockerfile for why there is no USER, and what each of these is for
ENV HOME=/root \
    ASQ_HOST=0.0.0.0 \
    ASQ_PORT=7717 \
    ASQ_INDEX=/data/index.db \
    ASQ_STATE=/data

VOLUME ["/data"]
EXPOSE 7717

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 CMD ["/asq", "ping"]

ENTRYPOINT ["/asq"]
CMD ["serve"]
